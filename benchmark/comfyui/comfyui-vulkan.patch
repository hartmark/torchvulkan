     logging.info("Using deterministic algorithms for pytorch")
     torch.use_deterministic_algorithms(True, warn_only=True)
 
+vulkan_enabled = False
+if args.vulkan:
+    import torchvulkan
+    vulkan_enabled = True
+    logging.info("Using torchvulkan {} on {}".format(torchvulkan.__version__, torchvulkan.get_device_name()))
+
+def _vulkan_sysfs(name):
+    # The GPU is shared with other processes; torchvulkan only knows its own
+    # allocations, so read device-wide VRAM usage from amdgpu sysfs (the card
+    # with the most VRAM, i.e. the discrete GPU).
+    import glob
+    best = None
+    for d in glob.glob("/sys/class/drm/card[0-9]*/device"):
+        try:
+            total = int(open(d + "/mem_info_vram_total").read())
+            value = int(open(d + "/" + name).read())
+        except (OSError, ValueError):
+            continue
+        if best is None or total > best[0]:
+            best = (total, value)
+    return None if best is None else best[1]
+
