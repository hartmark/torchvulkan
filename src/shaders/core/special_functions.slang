}

public float chebyshev_polynomial_u_forward(float x, int n)
{
    if (n < 0)
    {
        return float(0.0);
    }

    if (abs(x) == float(1.0))
    {
        if (x > float(0.0) || n % 2 == 0)
        {
            return n + 1;
        }

        return -(n + 1);
    }

    if ((n > 8) && (abs(x) < float(1.0)))
    {
        if (sin(acos(x)) != float(0.0))
        {
            return sin((n + 1) * acos(x)) / sin(acos(x));
        }

        return (n + 1) * cos((n + 1) * acos(x)) / x;
    }

    if (n == 0)
    {
        return float(1.0);
    }

    if (n == 1)
    {
        return x + x;
    }

    float p = float(1.0);
    float q = x + x;
    float r;

    for (int k = 2; (k <= n) && !isnan(q); k++)
    {
        r = (x + x) * q - p;
        p = q;
        q = r;
    }

    return r;
}

public float chebyshev_polynomial_u_forward(float x, float n)
{
    return chebyshev_polynomial_u_forward(x, int(n));
}

public float chebyshev_polynomial_v_forward(float x, int n)
{
    if (n < 0)
    {
        return float(0.0);
    }

    if (abs(x) == float(1.0))
    {
        if (x > float(0.0))
        {
            return float(1.0);
        }

        if (n % 2 == 0)
        {
            return n + n + 1;
        }

        return -(n + n + 1);
    }

    if ((n > 8) && (abs(x) < float(1.0)))
    {
        if (sin(acos(x) / float(2.0)) != float(1.0))
        {
            return cos((n + float(0.5)) * acos(x)) / cos(acos(x) / float(2.0));
        }

        if (n % 2 == 0)
        {
            return n + n + 1;
        }

        return -(n + n + 1);
    }

    if (n == 0)
    {
        return float(1.0);
    }

    if (n == 1)
    {
        return x + x - float(1.0);
    }

    float p = float(1.0);
    float q = x + x - float(1.0);
    float r;

    for (int k = 2; (k <= n) && !isnan(q); k++)
    {
        r = (x + x) * q - p;
        p = q;
        q = r;
    }

    return r;
}

