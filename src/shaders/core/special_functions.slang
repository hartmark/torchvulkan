public float chebyshev_polynomial_t_forward(float x, int n)
{
    if (n < 0)
    {
        return float(0.0);
    }

    if (abs(x) == float(1.0))
    {
        if (x > float(0.0) || n % 2 == 0)
        {
            return float(1.0);
        }

        return float(-1.0);
    }

    if ((n > 6) && (abs(x) < float(1.0)))
    {
        return cos(n * acos(x));
    }

    if (n == 0)
    {
        return float(1.0);
    }

    if (n == 1)
    {
        return x;
    }

    float p = float(1.0);
    float q = x;
    float r = x;

    for (int k = 2; (k <= n) && !isnan(q); k++)
    {
        r = (x + x) * q - p;
        p = q;
        q = r;
    }

    return r;
}

public float chebyshev_polynomial_t_forward(float x, float n)
{
