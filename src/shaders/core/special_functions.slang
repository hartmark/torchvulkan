module special_functions;

// float32 ports of ATen/native/Math.h's special functions (from Cephes, SciPy and Boost)

__exported import core.dtype;

float _nan() { return asfloat(0x7fc00000u); }
float _inf() { return asfloat(0x7f800000u); }

float polevl<let N : int>(float x, float A[N], int len)
{
    float result = 0;
    for (int i = 0; i <= len; i++) result = result * x + A[i];
    return result;
}

// std::pow's sign for a negative base with an integer exponent; the GPU's pow is NaN for any negative base
float signedPow(float base, float exponent)
{
    if (base >= 0.0f || exponent != floor(exponent)) return pow(base, exponent);
    float r = pow(-base, exponent);
    return (fmod(abs(exponent), 2.0f) == 1.0f) ? -r : r;
}

public float trigamma(float x)
{
    float sign = 1;
    float result = 0;
    if (x < 0.5f)
    {
        sign = -1;
        float sin_pi_x = sin(3.14159265358979323846f * x);
        result -= (3.14159265358979323846f * 3.14159265358979323846f) / (sin_pi_x * sin_pi_x);
        x = 1 - x;
    }
    for (int i = 0; i < 6; ++i)
    {
        result += 1 / (x * x);
        x += 1;
    }
    float ixx = 1 / (x * x);
    result += (1 + 1 / (2 * x) + ixx * (1.f / 6 - ixx * (1.f / 30 - ixx * (1.f / 42)))) / x;
    return sign * result;
}

public float zeta(float x, float q)
{
    const float MACHEP = float(1.11022302462515654042E-16);
    const float zero = float(0.0);
    const float half = float(0.5);
    const float one = float(1.0);
    static const float A[12] = {
        12.0,
        -720.0,
        30240.0,
        -1209600.0,
        47900160.0,
        -1.8924375803183791606e9,
        7.47242496e10,
        -2.950130727918164224e12,
        1.1646782814350067249e14,
        -4.5979787224074726105e15,
        1.8152105401943546773e17,
        -7.1661652561756670113e18
    };

    float a, b, k, s, t, w;
    if (x == one)
    {
        return _inf();
    }

    if (x < one)
    {
        return _nan();
    }

    if (q <= zero)
    {
        if (q == floor(q))
        {
            return _inf();
        }
        if (x != floor(x))
        {
            return _nan();
        }
    }

    s = signedPow(q, -x);
    a = q;
    int i = 0;
    b = zero;
    while ((i < 9) || (a <= float(9.0)))
    {
        i += 1;
        a += one;
        b = signedPow(a, -x);
        s += b;
        if ((-MACHEP * s < b) && (b < MACHEP * s))
        {
            return s;
        }
    };

    w = a;
    s += b * w / (x - one);
    s -= half * b;
    a = one;
    k = zero;
    for (i = 0; i < 12; i++)
    {
        a *= x + k;
        b /= w;
        t = a * b / A[i];
        s = s + t;
        t = abs(t / s);
        if (t < MACHEP)
        {
            return s;
        }
        k += one;
        a *= x + k;
        b /= w;
        k += one;
    }
    return s;
}

public float ndtri(float y0)
{


    const float s2pi = 2.50662827463100050242E0;
    const float one = 1;
    const float zero = 0;


    static const float P0[5] = {
        -5.99633501014107895267E1,
        9.80010754185999661536E1,
        -5.66762857469070293439E1,
        1.39312609387279679503E1,
        -1.23916583867381258016E0,
    };

    static const float Q0[9] = {
        1.00000000000000000000E0,
        1.95448858338141759834E0,
        4.67627912898881538453E0,
        8.63602421390890590575E1,
        -2.25462687854119370527E2,
        2.00260212380060660359E2,
        -8.20372256168333339912E1,
        1.59056225126211695515E1,
        -1.18331621121330003142E0,
    };


    static const float P1[9] = {
        4.05544892305962419923E0,
        3.15251094599893866154E1,
        5.71628192246421288162E1,
        4.40805073893200834700E1,
        1.46849561928858024014E1,
        2.18663306850790267539E0,
        -1.40256079171354495875E-1,
        -3.50424626827848203418E-2,
        -8.57456785154685413611E-4,
    };

    static const float Q1[9] = {
        1.00000000000000000000E0,
        1.57799883256466749731E1,
        4.53907635128879210584E1,
        4.13172038254672030440E1,
        1.50425385692907503408E1,
        2.50464946208309415979E0,
        -1.42182922854787788574E-1,
        -3.80806407691578277194E-2,
        -9.33259480895457427372E-4,
    };



    static const float P2[9] = {
        3.23774891776946035970E0,
        6.91522889068984211695E0,
        3.93881025292474443415E0,
        1.33303460815807542389E0,
        2.01485389549179081538E-1,
        1.23716634817820021358E-2,
        3.01581553508235416007E-4,
        2.65806974686737550832E-6,
        6.23974539184983293730E-9,
    };

    static const float Q2[9] = {
        1.00000000000000000000E0,
        6.02427039364742014255E0,
        3.67983563856160859403E0,
        1.37702099489081330271E0,
        2.16236993594496635890E-1,
        1.34204006088543189037E-2,
        3.28014464682127739104E-4,
        2.89247864745380683936E-6,
        6.79019408009981274425E-9,
    };

    if (y0 == zero)
    {
        return -_inf();
    }
    if (y0 == one)
    {
        return _inf();
    }
    if (y0 < zero || y0 > one)
    {
        return _nan();
    }
    bool code = true;
    float y = y0;
    if (y > one - float(0.13533528323661269189))
    {
        y = one - y;
        code = false;
    }

    if (y > float(0.13533528323661269189))
    {
        y = y - float(0.5);
        const float y2 = y * y;
        float x = y + y * (y2 * polevl(y2, P0, 4) / polevl(y2, Q0, 8));
        return (x * s2pi);
    }

    float x = sqrt(float(-2.0) * log(y));
    const float x0 = x - log(x) / x;

    const float z = one / x;
    float x1;
    if (x < float(8.0))
    {
        x1 = z * polevl(z, P1, 8) / polevl(z, Q1, 8);
    }
    else
    {
        x1 = z * polevl(z, P2, 8) / polevl(z, Q2, 8);
    }
    x = x0 - x1;
    if (code)
    {
        x = -x;
    }
    return x;
}

float ratevl_lanczos(float x, float num[13], float denom[13])
{
    float absx = abs(x);
    float y = absx > 1 ? 1 / x : x;
    float num_ans = 0;
    float denom_ans = 0;
    for (int i = 0; i <= 12; i++)
    {
        int j = absx > 1 ? 12 - i : i;
        num_ans = num_ans * y + num[j];
        denom_ans = denom_ans * y + denom[j];
    }
    return num_ans / denom_ans;
}

// SciPy's lanczos implementation is taken from Boost

float lanczos_sum_expg_scaled(float x)
{
    static const float lanczos_sum_expg_scaled_num[13] = {
        0.006061842346248906525783753964555936883222,
        0.5098416655656676188125178644804694509993,
        19.51992788247617482847860966235652136208,
        449.9445569063168119446858607650988409623,
        6955.999602515376140356310115515198987526,
        75999.29304014542649875303443598909137092,
        601859.6171681098786670226533699352302507,
        3481712.15498064590882071018964774556468,
        14605578.08768506808414169982791359218571,
        43338889.32467613834773723740590533316085,
        86363131.28813859145546927288977868422342,
        103794043.1163445451906271053616070238554,
        56906521.91347156388090791033559122686859
    };
    static const float lanczos_sum_expg_scaled_denom[13] = {
        1.,
        66.,
        1925.,
        32670.,
        357423.,
        2637558.,
        13339535.,
        45995730.,
        105258076.,
        150917976.,
        120543840.,
        39916800.,
        0.
    };
    return ratevl_lanczos(x, lanczos_sum_expg_scaled_num, lanczos_sum_expg_scaled_denom);
}

float _igam_helper_fac(float a, float x)
{

    float ax, fac, res, num, numfac;
    const float MAXLOG = 88.72283905206835;
    const float EXP1 = 2.718281828459045;
    const float lanczos_g = 6.024680040776729583740234375;

    if (abs(a - x) > 0.4 * abs(a))
    {
        ax = a * log(x) - x - float.ext_lgamma(a);
        if (ax < -MAXLOG)
        {
            return 0.0;
        }
        return exp(ax);
    }

    fac = a + lanczos_g - 0.5;
    res = sqrt(fac / EXP1) / lanczos_sum_expg_scaled(a);

    if ((a < 200) && (x < 200))
    {
        res *= exp(a - x) * pow(x / fac, a);
    }
    else
    {
        num = x - a - lanczos_g + 0.5;
        numfac = num / fac;
        res *= exp(a * (float.ext_log1p(numfac) - numfac) + x * (0.5 - lanczos_g) / fac);
    }
    return res;
}

float _igam_helper_series(float a, float x)
{
    const float MACHEP = 5.9604644775390625E-8;
    const int MAXITER = 2000;

    int i;
    float ans, ax, c, r;

    ax = _igam_helper_fac(a, x);
    if (ax == 0.0)
    {
        return 0.0;
    }


    r = a;
    c = 1.0;
    ans = 1.0;

    for (i = 0; i < MAXITER; i++)
    {
        r += 1.0;
        c *= x / r;
        ans += c;
        if (c <= MACHEP * ans)
        {
            break;
        }
    }
    return (ans * ax / a);
}

float _igamc_helper_series(float a, float x)
{

    int n;
    float fac = 1;
    float sum = 0;
    float term, logx;
    const float MAXITER = 2000;
    const float MACHEP = 5.9604644775390625E-8;

    for (n = 1; n < MAXITER; n++)
    {
        fac *= -x / n;
        term = fac / (a + n);
        sum += term;
        if (abs(term) <= MACHEP * abs(sum))
        {
            break;
        }
    }

    logx = log(x);
    term = -float.ext_expm1(a * logx - float.ext_lgamma(1+a));
    return term - exp(a * logx - float.ext_lgamma(a)) * sum;
}

