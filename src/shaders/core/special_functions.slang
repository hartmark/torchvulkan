public float laguerre_polynomial_l_forward(float x, int n)
{
    if (n < 0)
    {
        return float(0.0);
    }

    if (abs(x) == float(0.0))
    {
        return float(1.0);
    }

    if (n == 0)
    {
        return float(1.0);
    }

    if (n == 1)
    {
        return float(1.0) - x;
    }

    float p = float(1.0);
    float q = float(1.0) - x;
    float r;

    for (int k = 1; (k < n) && !isnan(q); k++)
    {
        r = (((k + k) + (float(1.0) - x)) * q - k * p) / (k + 1);
        p = q;
        q = r;
    }

    return r;
}

