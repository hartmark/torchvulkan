        -1.73028895751305206302e-04,
        -6.97572385963986435018e-03,
        -1.22611180822657148235e-01,
        -3.53155960776544875667e-01,
        +1.52530022733894777053e+00,
    };

    static const float B[25] = {
        -5.75674448366501715755e-18,
        +1.79405087314755922667e-17,
        -5.68946255844285935196e-17,
        +1.83809354436663880070e-16,
        -6.05704724837331885336e-16,
        +2.03870316562433424052e-15,
        -7.01983709041831346144e-15,
        +2.47715442448130437068e-14,
        -8.97670518232499435011e-14,
        +3.34841966607842919884e-13,
        -1.28917396095102890680e-12,
        +5.13963967348173025100e-12,
        -2.12996783842756842877e-11,
        +9.21831518760500529508e-11,
        -4.19035475934189648750e-10,
        +2.01504975519703286596e-09,
        -1.03457624656780970260e-08,
        +5.74108412545004946722e-08,
        -3.50196060308781257119e-07,
        +2.40648494783721712015e-06,
        -1.93619797416608296024e-05,
        +1.95215518471351631108e-04,
        -2.85781685962277938680e-03,
        +1.03923736576817238437e-01,
        +2.72062619048444266945e+00,
    };

    if (x == float(0.0))
    {
        return _inf();
    }

    if (x < float(0.0))
    {
        return _nan();
    }

    float p = float(0);
    float q = 0.0;

    if (x <= float(2.0))
    {
        float a = A[0];

        for (uint index = 1; index < 11; index++)
        {
            p = q;
            q = a;
            a = (x * x - float(2.0)) * q - p + A[index];
        }

        return (log(float(0.5) * x) * modified_bessel_i1_forward(x) + float(0.5) * (a - p) / x) * exp(x);
    }

    float b = B[0];

    for (uint index = 1; index < 25; index++)
    {
        p = q;
        q = b;
        b = (float(8.0) / x - float(2.0)) * q - p + B[index];
    }

    return (float(0.5) * (b - p) / sqrt(x));
} // float scaled_modified_bessel_k1_forward(float x)

public float shifted_chebyshev_polynomial_t_forward(float x, int n)
{
    if (n < 0)
    {
        return float(0.0);
    }

    if (x == float(1.0))
    {
        return float(1.0);
    }

    if (x == float(0.0))
    {
        if (n % 2 == 0)
        {
            return float(1.0);
        }

        return float(-1.0);
    }

    if ((n > 6) && (abs(x + x - float(1.0)) < float(1.0)))
    {
        return cos(n * acos(x + x - float(1.0)));
    }

    if (n == 0)
    {
        return float(1.0);
    }

    if (n == 1)
    {
        return x + x - float(1.0);
    }

    float p = float(1.0);
    float q = x + x - float(1.0);
    float r;

    for (int k = 2; (k <= n) && !isnan(q); k++)
    {
        r = (x + x - float(1.0) + (x + x - float(1.0))) * q - p;
        p = q;
        q = r;
    }

    return r;
}

public float shifted_chebyshev_polynomial_t_forward(float x, float n)
{
    return shifted_chebyshev_polynomial_t_forward(x, int(n));
}

public float shifted_chebyshev_polynomial_u_forward(float x, int n)
{
    if (n < 0)
    {
        return float(0.0);
    }

    if (x == float(1.0))
    {
        return n + 1;
    }

    if (x == float(0.0))
    {
        if (n % 2 == 0)
        {
            return n + 1;
        }

        return -(n + 1);
    }

    if ((n > 6) && (abs(x + x - float(1.0)) < float(1.0)))
    {
        if (sin(acos(x + x - float(1.0))) != float(0.0))
        {
            return sin((n + 1) * acos(x + x - float(1.0))) / sin(acos(x + x - float(1.0)));
        }

        return (n + 1) * cos((n + 1) * acos(x + x - float(1.0))) / (x + x - float(1.0));
    }

    if (n == 0)
    {
        return float(1.0);
    }

    if (n == 1)
    {
        return x + x - float(1.0) + (x + x - float(1.0));
    }

    float p = float(1.0);
    float q = x + x - float(1.0) + (x + x - float(1.0));
    float r;

    for (int k = 2; (k <= n) && !isnan(q); k++)
    {
        r = (x + x - float(1.0) + (x + x - float(1.0))) * q - p;
        p = q;
        q = r;
    }

    return r;
}

public float shifted_chebyshev_polynomial_u_forward(float x, float n)
{
    return shifted_chebyshev_polynomial_u_forward(x, int(n));
}

public float shifted_chebyshev_polynomial_v_forward(float x, int n)
{
    if (n < 0)
    {
        return float(0.0);
    }

    if (x == float(1.0))
    {
        return float(1.0);
    }

    if (x == float(0.0))
    {
        if (n % 2 == 0)
        {
            return (n + n + 1);
        }

        return -(n + n + 1);
    }

    if ((n > 6) && (abs(x + x - float(1.0)) < float(1.0)))
    {
        if (sin(acos(x + x - float(1.0)) / float(2.0)) != float(1.0))
        {
            return cos((n + float(0.5)) * acos(x + x - float(1.0))) / cos(acos(x + x - float(1.0)) / float(2.0));
        }

        if (n % 2 == 0)
        {
            return n + n + 1;
        }

        return -(n + n + 1);
    }

    if (n == 0)
    {
        return float(1.0);
    }

    if (n == 1)
    {
        return x + x - float(1.0) + (x + x - float(1.0)) - float(1.0);
    }

    float p = float(1.0);
    float q = x + x - float(1.0) + (x + x - float(1.0)) - float(1.0);
    float r;

    for (int k = 2; (k <= n) && !isnan(q); k++)
    {
        r = (x + x - float(1.0) + (x + x - float(1.0))) * q - p;
        p = q;
        q = r;
    }

    return r;
}

public float shifted_chebyshev_polynomial_v_forward(float x, float n)
{
    return shifted_chebyshev_polynomial_v_forward(x, int(n));
}

public float shifted_chebyshev_polynomial_w_forward(float x, int n)
{
    if (n < 0)
    {
        return float(0.0);
    }

    if (x == float(1.0))
    {
        return n + n + 1;
    }

    if (x == float(0.0))
    {
        if (n % 2 == 0)
        {
            return float(1.0);
        }

        return float(-1.0);
    }

    if ((n > 4) && (abs(x + x - float(1.0)) < float(1.0)))
    {
        if (cos(acos(x + x - float(1.0)) / float(2.0)) != float(1.0))
        {
            return sin((n + float(0.5)) * acos(x + x - float(1.0))) / sin(acos(x + x - float(1.0)) / float(2.0));
        }

        if (n % 2 == 0)
        {
            return float(1.0);
        }

        return float(-1.0);
    }

    if (n == 0)
    {
        return float(1.0);
    }

    if (n == 1)
    {
        return x + x - float(1.0) + (x + x - float(1.0)) + float(1.0);
    }

    float p = float(1.0);
    float q = x + x - float(1.0) + (x + x - float(1.0)) + float(1.0);
    float r;

    for (int k = 2; (k <= n) && !isnan(q); k++)
    {
        r = (x + x - float(1.0) + (x + x - float(1.0))) * q - p;
        p = q;
        q = r;
    }

    return r;
}

public float shifted_chebyshev_polynomial_w_forward(float x, float n)
{
    return shifted_chebyshev_polynomial_w_forward(x, int(n));
}

public float spherical_bessel_j0_forward(float x)
{
    if (isinf(x))
    {
        return float(0.0);
    }

    if (abs(x) < float(0.5))
    {
        return float(1.0) + x * x * (float(-1.0) / float(6.0) + x * x * (float(1.0) / float(120.0) + x * x * (float(-1.0) / float(5040.0) + x * x * (float(1.0) / float(362880.0) + x * x * (float(-1.0) / float(39916800.0) + x * x * (float(1.0) / float(6227020800.0)))))));
    }

    return sin(x) / x;
} // float spherical_bessel_j0_forward(float x)

public float polygamma(float x, int n)
{
    if (n == 0) return float.ext_digamma(x);
    if (n == 1) return trigamma(x);
    return ((n % 2) != 0 ? 1.0f : -1.0f) * exp(float.ext_lgamma(float(n) + 1.0f)) * zeta(float(n + 1), x);
}
