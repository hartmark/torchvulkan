    if (n == 0)
    {
        return float(1.0);
    }

    if (n == 1)
    {
        return x;
    }

    float p = float(1.0);
    float q = x;
    float r;

    for (int k = 1; (k < n) && !isnan(q); k++)
    {
        r = ((k + k + 1) * x * q - k * p) / (k + 1);
        p = q;
        q = r;
    }

    return r;
}

