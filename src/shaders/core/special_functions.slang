public float hermite_polynomial_h_forward(float x, int n)
{
    if (n < 0)
    {
        return float(0.0);
    }

    if (n == 0)
    {
        return float(1.0);
    }

    if (n == 1)
    {
        return x + x;
    }

    if (n > 128)
    {
        return _nan();
    }

    float p = float(1.0);
    float q = x + x;
    float r = float(0.0);

    for (int k = 2; k < n + n; k += 2)
    {
        r = (x + x) * q - k * p;
        p = q;
        q = r;
    }

    return r;
}

