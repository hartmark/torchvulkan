    }

    if (abs(x) == float(1.0))
    {
        if (x > float(0.0))
        {
            return n + n + 1;
        }

        if (n % 2 == 0)
        {
            return float(1.0);
        }

        return float(-1.0);
    }

    if ((n > 8) && (abs(x) < float(1.0)))
    {
