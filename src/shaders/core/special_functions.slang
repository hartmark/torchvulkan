public float hermite_polynomial_he_forward(float x, int n)
{
    if (n < 0)
    {
        return float(0.0);
    }

    if (n == 0)
    {
        return float(1.0);
    }

    if (n == 1)
    {
        return x;
    }

    if (n > 128)
    {
        return _nan();
    }

    float p = float(1.0);
    float q = x;
    float r;

    for (int k = 1; k < n; k++)
    {
        r = x * q - k * p;
        p = q;
        q = r;
    }

    return r;
}

