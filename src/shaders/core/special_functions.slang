        {
            return sin((n + float(0.5)) * acos(x)) / sin(acos(x) / float(2.0));
        }

        if (x > float(0.0))
        {
            return n + n + 1;
        }

        if (n % 2 == 0)
        {
            return float(1.0);
        }

        return float(-1.0);
    }

    if (n == 0)
    {
        return float(1.0);
    }

    if (n == 1)
    {
        return x + x + float(1.0);
    }

    float p = float(1.0);
    float q = x + x + float(1.0);
    float r;

    for (int k = 2; (k <= n) && !isnan(q); k++)
    {
        r = (x + x) * q - p;
